<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Online_Battleship.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Online_Battleship"
    xmlns:views="clr-namespace:Online_Battleship.Views"
    Title="Online_Battleship"
    Shell.NavBarIsVisible="False">

    <ShellContent
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <ShellContent
    ContentTemplate="{DataTemplate views:RegisterPage}"
    Route="RegisterPage" />

    <ShellContent
    ContentTemplate="{DataTemplate views:MainPage}"
    Route="MainPage" />

    <ShellContent
    ContentTemplate="{DataTemplate views:MatchPage}"
    Route="MatchPage" />

    <ShellContent
    ContentTemplate="{DataTemplate views:ShipPlacementPage}"
    Route="ShipPlacementPage" />
    
    <ShellContent
    ContentTemplate="{DataTemplate views:GamePage}"
    Route="GamePage" />
    
    <ShellContent
    ContentTemplate="{DataTemplate views:PlayersPage}"
    Route="PlayersPage" />

    <ShellContent
    ContentTemplate="{DataTemplate views:LeaderboardPage}"
    Route="LeaderboardPage" />

    <ShellContent
    ContentTemplate="{DataTemplate views:MatchHistoryPage}"
    Route="MatchHistoryPage" />
</Shell>
