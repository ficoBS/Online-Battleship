<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Online_Battleship.Views.LoginPage">
    <Grid>
        <Image Source="background.png" Aspect="Fill" HorizontalOptions="Fill" VerticalOptions="Fill" />
        <Image Source="battleship_logo.png" WidthRequest="{OnPlatform WinUI=450, Android=280}" HorizontalOptions="Center"
               VerticalOptions="Start" />

        <Border BackgroundColor="#CC000000" WidthRequest="{OnPlatform WinUI=420, Android=340}" VerticalOptions="Center"
                HorizontalOptions="Center" Padding="25,15,25,25">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="15" />
            </Border.StrokeShape>
            <Border.Stroke>
                <SolidColorBrush Color="Transparent" />
            </Border.Stroke>

            <StackLayout>
                <Label Text="Login" FontSize="Header" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,0,0,10" TextColor="White" />
                <Entry x:Name="emailEntry" Placeholder="Email" TextColor="Black" BackgroundColor="White" 
                       ReturnType="Next" Keyboard="Email" />
                <Entry x:Name="passwordEntry" Placeholder="Password" TextColor="Black" BackgroundColor="White"
                       ReturnType="Go" IsPassword="True" Margin="0,5,0,0" />
                <StackLayout Orientation="Horizontal" Padding="0" HorizontalOptions="Center">
                    <Label Text="Don't have an account?" TextColor="White" />
                    <Label Text="Register" TextColor="Red" Margin="10,0,0,0" FontAttributes="Bold">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="butCreateAccount_Clicked" />
                        </Label.GestureRecognizers>
                    </Label>
                </StackLayout>

                <Button x:Name="butLogin" Text="Login" BackgroundColor="LightBlue" TextColor="Black" FontSize="20"
                        FontAttributes="Bold" Margin="0,20,0,0" CornerRadius="10" Clicked="butLogin_Clicked" />
            </StackLayout>
        </Border>
    </Grid>
</ContentPage>