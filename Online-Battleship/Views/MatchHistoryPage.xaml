<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Online_Battleship.Views.MatchHistoryPage">
    <Grid RowDefinitions="Auto,*">
        <Image Source="background.png" Aspect="Fill" HorizontalOptions="Fill" VerticalOptions="Fill"
               Grid.RowSpan="2" />

        <Image Source="battleship_logo.png" WidthRequest="{OnPlatform WinUI=450, Android=280}"
               HorizontalOptions="Center" VerticalOptions="Start"
               Grid.Row="0" Margin="0,20,0,0" />

        <Border Grid.Row="1" BackgroundColor="#CC000000"
                WidthRequest="{OnPlatform WinUI=420, Android=340}"
                VerticalOptions="Center" HorizontalOptions="Center"
                Padding="25,15,25,25" Margin="0,0,0,20">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="15" />
            </Border.StrokeShape>
            <Border.Stroke>
                <SolidColorBrush Color="Transparent" />
            </Border.Stroke>

            <VerticalStackLayout Spacing="15">
                <Label Text="Match History" FontSize="Header" FontAttributes="Bold"
                       HorizontalOptions="Center" Margin="0,0,0,10" TextColor="White" />

                <CollectionView x:Name="historyList" HeightRequest="300">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid RowDefinitions="Auto,Auto" Padding="0,8">
                                <Label Grid.Row="0" TextColor="White" FontAttributes="Bold" FontSize="14">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Player1Username}" TextColor="LightBlue" />
                                            <Span Text=" vs " TextColor="White" />
                                            <Span Text="{Binding Player2Username}" TextColor="LightBlue" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Grid.Row="1" FontSize="12">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Winner: " TextColor="Gray" />
                                            <Span Text="{Binding WinnerUsername}" TextColor="Gold" />
                                            <Span Text="  " />
                                            <Span Text="{Binding StartedAt, StringFormat='{0:dd/MM/yyyy}'}" TextColor="Gray" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button x:Name="butBack" Text="Back" BackgroundColor="LightBlue" TextColor="Black"
                        FontSize="20" FontAttributes="Bold" CornerRadius="10" Clicked="butBack_Clicked" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>